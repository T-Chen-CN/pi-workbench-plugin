# 统一换行符：仓库内一律 LF，检出也使用 LF
* text=auto eol=lf

# 脚本显式声明为 LF，避免 Windows 下被转成 CRLF 无法执行
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行转换与 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.woff binary
*.woff2 binary
*.ttf  binary
